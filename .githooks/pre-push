#!/usr/bin/env bash
# pre-push gate: the test suite must pass before any push reaches the remote.
#
# Activated by `git config core.hooksPath .githooks` (done by bin/conductor-setup,
# or run it once manually). Bypass in a genuine emergency with `git push --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "==> pre-push: running swift test before push..."
if ! swift test; then
  echo >&2
  echo "✗ pre-push blocked: swift test failed. Fix the tests, then push again." >&2
  echo "  (To bypass in an emergency: git push --no-verify)" >&2
  exit 1
fi

echo "==> pre-push: tests passed — allowing push."
